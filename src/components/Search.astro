---
import { url } from '../lib/nav';
import { domains, iconSvg } from '../data/domains';
// Pagefind builds its index into dist/pagefind after `astro build`, so search
// only works in `bun run build && bun run preview` and on the deployed site.
// Results are rendered here (not by pagefind-ui) so they can group by primary domain.
// Each note page tags itself with data-pagefind-meta="domain:<slug>".
const domainMap = Object.fromEntries(domains.map((d) => [d.slug, { title: d.name, colour: d.colour, icon: iconSvg(d.slug, 14) }]));
---

<button class="search-btn" type="button" data-search-open data-pagefind={url('pagefind/')}>
  <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <circle cx="9" cy="9" r="6"></circle><path d="m17 17-3.5-3.5"></path>
  </svg>
  <span class="label">Search notes</span>
  <kbd data-kbd>Ctrl K</kbd>
</button>

<dialog class="search-dialog" aria-label="Search notes" data-domain-map={JSON.stringify(domainMap)}>
  <div class="search-panel">
    <label class="search-field">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <circle cx="9" cy="9" r="6"></circle><path d="m17 17-3.5-3.5"></path>
      </svg>
      <input type="search" placeholder="Search notes, topics, formulas…" autocomplete="off" spellcheck="false" aria-label="Search notes" />
      <kbd>Esc</kbd>
    </label>
    <div class="search-body" aria-live="polite"></div>
    <footer class="search-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>Esc</kbd> close</span>
    </footer>
  </div>
</dialog>

<style is:global>
  .search-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    width: min(340px, 100%);
    padding: 8px 12px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    color: var(--text-faint);
    font-size: 0.875rem;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .search-btn:hover {
    border-color: var(--border-strong);
    color: var(--text-muted);
  }
  .search-btn .label {
    flex: 1;
    text-align: left;
  }
  .search-btn kbd,
  .search-dialog kbd {
    font: 0.6875rem var(--font-mono);
    color: var(--text-faint);
    padding: 2px 6px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--bg);
  }
  @media (max-width: 640px) {
    .search-btn {
      width: auto;
      padding: 7px;
      border-radius: 10px;
    }
    .search-btn .label,
    .search-btn kbd {
      display: none;
    }
  }

  .search-dialog {
    width: min(680px, calc(100vw - 32px));
    max-height: min(680px, calc(100dvh - 80px));
    margin: 64px auto auto;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: 18px;
    background: var(--bg-elev);
    color: var(--text);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.6);
  }
  .search-dialog::backdrop {
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
  }
  .search-panel {
    display: flex;
    flex-direction: column;
    max-height: min(680px, calc(100dvh - 80px));
  }
  .search-field {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    border-bottom: 1px solid var(--border);
    color: var(--text-faint);
    cursor: text;
  }
  .search-field:focus-within {
    color: var(--accent);
  }
  .search-field input {
    flex: 1;
    min-width: 0;
    background: none;
    border: 0;
    outline: none;
    color: var(--text);
    font: 1.0625rem var(--font-sans);
  }
  .search-field input::placeholder {
    color: var(--text-faint);
  }
  .search-body {
    flex: 1;
    overflow-y: auto;
    padding: 8px 8px 12px;
    min-height: 120px;
  }
  .search-status {
    margin: 0;
    padding: 28px 18px;
    text-align: center;
    color: var(--text-faint);
    font-size: 0.9375rem;
  }
  .search-dot {
    display: inline-flex;
    flex: none;
  }
  .search-group + .search-group {
    margin-top: 10px;
  }
  .search-group h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 10px 12px 6px;
    font: 600 0.6875rem var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .search-hit {
    display: block;
    padding: 10px 12px;
    border-radius: 12px;
    color: var(--text);
  }
  .search-hit.active,
  .search-sub.active {
    background: var(--bg-hover);
  }
  .search-hit .hit-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .search-hit .hit-title {
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .search-hit .crumb {
    font: 0.6875rem var(--font-mono);
    color: var(--text-faint);
    white-space: nowrap;
  }
  .search-excerpt {
    margin: 4px 0 0;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .search-sub {
    display: flex;
    gap: 8px;
    margin: 2px 0 0 12px;
    padding: 6px 10px;
    border-radius: 10px;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .search-sub::before {
    content: '↳';
    color: var(--text-faint);
  }
  .search-sub .sub-title {
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
  }
  .search-dialog mark {
    background: rgba(242, 184, 75, 0.22);
    color: var(--accent);
    border-radius: 3px;
    padding: 0 2px;
  }
  .search-foot {
    display: flex;
    gap: 18px;
    padding: 10px 18px;
    border-top: 1px solid var(--border);
    font-size: 0.75rem;
    color: var(--text-faint);
  }
  .search-foot kbd {
    margin-right: 4px;
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-search-open]')!;
  const dialog = document.querySelector<HTMLDialogElement>('.search-dialog')!;
  const input = dialog.querySelector<HTMLInputElement>('input')!;
  const body = dialog.querySelector<HTMLDivElement>('.search-body')!;
  const kbd = document.querySelector<HTMLElement>('[data-kbd]')!;

  type DomainInfo = { title: string; colour: string; icon: string };
  const domainMap: Record<string, DomainInfo> = JSON.parse(dialog.dataset.domainMap || '{}');
  const indexBase = btn.dataset.pagefind!; // e.g. /alexandria/pagefind/

  // show the shortcut that matches the device
  if (/Mac|iPhone|iPad|iPod/.test(navigator.userAgent)) kbd.textContent = '⌘K';

  // pagefind's JS API, loaded once on first open; fails in dev (no index)
  // Vite's dev server can't serve public/ modules imported this way (500), so the import is hidden from it
  const importModule = new Function('url', 'return import(url)') as (url: string) => Promise<any>;
  let pagefind: any = null;
  let loading: Promise<unknown> | null = null;
  function loadIndex() {
    loading ??= importModule(indexBase + 'pagefind.js').then((m) => (pagefind = m));
    return loading;
  }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
    const node = document.createElement(tag);
    if (cls) node.className = cls;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function hint(text: string) {
    body.replaceChildren(el('p', 'search-status', text));
  }

  // raw pagefind data for one page; excerpts come from pagefind and contain <mark> tags
  type Hit = { title: string; url: string; excerpt: string; domain: string; subs: { title: string; url: string; excerpt: string }[] };

  function render(query: string, total: number, hits: Hit[]) {
    if (!hits.length) return hint(`No matches for “${query}”.`);
    const nodes: Node[] = [el('p', 'search-status', `${total} result${total === 1 ? '' : 's'}`)];
    const groups = new Map<string, Hit[]>();
    for (const h of hits) groups.set(h.domain, [...(groups.get(h.domain) ?? []), h]);
    for (const [domainId, items] of groups) {
      const info = domainMap[domainId];
      const group = el('section', 'search-group');
      const heading = el('h3');
      const dot = el('span', 'search-dot');
      dot.style.color = info?.colour ?? 'var(--text-faint)';
      dot.innerHTML = info?.icon ?? '';
      heading.append(dot,el('span', '', info?.title ?? domainId));
      group.append(heading);
      for (const h of items) {
        const link = el('a', 'search-hit');
        link.href = h.url;
        const top = el('div', 'hit-top');
        top.append(el('span', 'hit-title', h.title));
        link.append(top);
        const ex = el('p', 'search-excerpt');
        ex.innerHTML = h.excerpt;
        link.append(ex);
        group.append(link);
        for (const s of h.subs.slice(0, 2)) {
          const sub = el('a', 'search-sub');
          sub.href = s.url;
          sub.append(el('span', 'sub-title', s.title));
          const sx = el('span');
          sx.innerHTML = s.excerpt;
          sub.append(sx);
          group.append(sub);
        }
      }
      nodes.push(group);
    }
    body.replaceChildren(...nodes);
    setActive(0);
  }

  let seq = 0;
  async function run(query: string) {
    const mine = ++seq;
    const q = query.trim();
    if (!q) return hint('Start typing to search every note by title, text or formula.');
    try {
      await loadIndex();
      const res = await pagefind.search(q);
      const top = await Promise.all(res.results.slice(0, 15).map((r: any) => r.data()));
      if (mine !== seq) return;
      render(
        q,
        res.results.length,
        top.map((d: any) => ({
          title: d.meta?.title ?? d.url,
          url: d.url,
          excerpt: d.excerpt,
          domain: d.meta?.domain ?? '',
          subs: (d.sub_results ?? []).map((s: any) => ({ title: s.title, url: s.url, excerpt: s.excerpt })),
        })),
      );
    } catch {
      if (mine === seq)
        hint('Search index not found. In development, run `bun run search:dev` once (re-run it to pick up new notes).');
    }
  }

  // keyboard navigation over every result link
  let active = 0;
  function items() {
    return [...body.querySelectorAll<HTMLAnchorElement>('a.search-hit, a.search-sub')];
  }
  function setActive(i: number) {
    const list = items();
    list.forEach((a) => a.classList.remove('active'));
    if (!list.length) return;
    active = (i + list.length) % list.length;
    list[active].classList.add('active');
    list[active].scrollIntoView({ block: 'nearest' });
  }

  function open() {
    if (!dialog.open) dialog.showModal();
    loadIndex().catch(() => {});
    input.focus();
    input.select();
  }

  btn.addEventListener('click', open);
  input.addEventListener('input', () => run(input.value));
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setActive(active + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(active - 1);
    } else if (e.key === 'Enter') {
      const current = items()[active];
      if (current) {
        e.preventDefault();
        current.click();
      }
    }
  });
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  hint('Start typing to search every note by title, text or formula.');

  window.addEventListener('keydown', (e) => {
    const typing = (e.target as HTMLElement).closest('input, textarea, [contenteditable]');
    if ((e.key === 'k' && (e.ctrlKey || e.metaKey)) || (e.key === '/' && !typing)) {
      e.preventDefault();
      if (!dialog.open) open();
    }
  });
</script>
