---
// The Alexandria lighthouse, line art. Small sizes (32px and below) use a heavier stroke and drop the door and window.
// Colours: sand tower, coral roof and band, amber lantern with beams that fade as they leave it.
interface Props {
  size?: number;
}
const { size = 34 } = Astro.props;
const small = size <= 32;
const w = small ? 7 : 3;
---

<svg width={Math.round((size * 130) / 122)} height={size} viewBox="10 18 130 122" aria-hidden="true">
  <defs>
    <linearGradient id="lh-beam-l" gradientUnits="userSpaceOnUse" x1="66" y1="0" x2="12" y2="0">
      <stop offset="0" stop-color="#f2b84b" stop-opacity="0.8"></stop>
      <stop offset="1" stop-color="#f2b84b" stop-opacity="0.1"></stop>
    </linearGradient>
    <linearGradient id="lh-beam-r" gradientUnits="userSpaceOnUse" x1="84" y1="0" x2="138" y2="0">
      <stop offset="0" stop-color="#f2b84b" stop-opacity="0.8"></stop>
      <stop offset="1" stop-color="#f2b84b" stop-opacity="0.1"></stop>
    </linearGradient>
    <radialGradient id="lh-glow" gradientUnits="userSpaceOnUse" cx="75" cy="47" r="26">
      <stop offset="0" stop-color="#f2b84b" stop-opacity="0.45"></stop>
      <stop offset="1" stop-color="#f2b84b" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
  <circle cx="75" cy="47" r="26" fill="url(#lh-glow)"></circle>
  <polygon points="66,42 12,26 12,60 66,52" fill="url(#lh-beam-l)"></polygon>
  <polygon points="84,42 138,26 138,60 84,52" fill="url(#lh-beam-r)"></polygon>
  <polygon points="64.6,70 85.4,70 86.4,84 63.6,84" fill="#ee7d6b"></polygon>
  <polygon points="58,132 92,132 84,64 66,64" fill="none" stroke="#f1dcb0" stroke-width={w} stroke-linejoin="round"></polygon>
  {
    !small && (
      <>
        <path d="M70 132 V122 a5 5 0 0 1 10 0 V132" fill="none" stroke="#f1dcb0" stroke-width="2"></path>
        <rect x="72" y="88" width="6" height="10" rx="2" fill="none" stroke="#f1dcb0" stroke-width="2"></rect>
      </>
    )
  }
  <rect x="60" y="56" width="30" height="8" rx="2" fill="#f1dcb0"></rect>
  <rect x="66" y="38" width="18" height="18" rx="2" fill="#f2b84b"></rect>
  <polygon points="63,38 87,38 75,24" fill="#ee7d6b"></polygon>
  <line x1="40" y1="132" x2="110" y2="132" stroke="#f1dcb0" stroke-width={w} stroke-linecap="round"></line>
</svg>
