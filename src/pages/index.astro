---
import Base from '../layouts/Base.astro';
import DomainIcon from '../components/DomainIcon.astro';
import GraphView from '../components/GraphView.astro';
import { domains, iconSvg } from '../data/domains';
import { buildGraph } from '../lib/graph';
import { sky } from '../data/sky';
import { url } from '../lib/nav';

const g = await buildGraph();
if (g.broken.length) console.warn(`[graph] ${g.broken.length} broken note links:\n  ${g.broken.join('\n  ')}`);
console.log(`[graph] ${g.nodes.length} notes, ${g.edges.length} links`);
const data = {
  domains: domains.map((d) => ({ id: d.slug, title: d.name, colour: d.colour, icon: iconSvg(d.slug, 12) })),
  nodes: g.nodes,
  edges: g.edges,
  // the place's name stays out of the page: the script only needs its coordinates
  sky: { ...sky, place: { lat: sky.place.lat, lon: sky.place.lon }, stars: url('stars.json'), lines: url('constellation-lines.json') },
};
---

<Base title="Alexandria">
  <main class="graph-page">
    <header class="gp-head">
      <h1>Alexandria</h1>
      <p class="gp-lead">
        A personal library of notes on whatever is worth understanding, from physics and the mind to history and art. Each
        dot is a note: click one to see what it connects to, then open it.
      </p>
    </header>
    <section class="gp-how" aria-labelledby="gp-how">
      <h2 id="gp-how">Pull a thread</h2>
      <p>
        A list would stuff every idea into one drawer, and ideas hate drawers. So here they float next to whatever they
        secretly have in common. Poke a dot, follow the strings, see where you land. Hollow ones are still daydreams.
      </p>
    </section>
    <GraphView data={data}>
        <div slot="controls" class="gp-ctl">
          <div class="gp-row">
            {
              domains.map((d) => (
                <>
                  <input type="checkbox" hidden checked data-domain={d.slug} />
                  <button type="button" class="btn gp-domain" data-toggle aria-pressed="true" style={`--c: ${d.colour}`}>
                    <DomainIcon slug={d.slug} />
                    {d.name}
                  </button>
                </>
              ))
            }
          </div>
          <div class="gp-row">
            <input type="search" class="input gp-search" placeholder="Find a note…" aria-label="Find a note" data-q />
            <input type="checkbox" hidden data-orphans />
            <button type="button" class="btn" data-toggle aria-pressed="false">Hide orphans</button>
            <button type="button" class="btn" data-fit>Fit</button>
            <button type="button" class="btn" data-play aria-pressed="false">Animate</button>
          </div>
        </div>
    </GraphView>
  </main>
</Base>

<style>
  .graph-page {
    max-width: 1520px;
    margin: 0 auto;
    padding: 16px 24px 24px;
  }
  .gp-head {
    padding: 40px 0 28px;
  }
  .gp-head h1 {
    margin: 0;
    font-size: clamp(2.6rem, 8vw, 4.5rem);
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .gp-lead {
    max-width: 820px;
    margin: 20px 0 0;
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .gp-how {
    margin: 0 0 20px;
  }
  .gp-how h2 {
    margin: 0 0 8px;
    font-size: clamp(1.625rem, 4vw, 2.125rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .gp-how p {
    max-width: 72ch;
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text-muted);
  }
  .gp-ctl {
    display: grid;
    gap: 8px;
    margin-bottom: 12px;
  }
  .gp-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .gp-domain {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .gp-domain[aria-pressed='false'] {
    opacity: 0.45;
  }
  .gp-domain[aria-pressed='true'] {
    border-color: var(--c);
    color: var(--text);
    background: color-mix(in srgb, var(--c) 14%, transparent);
  }
  .gp-domain :global(.domain-icon) {
    color: var(--c);
  }
  .gp-search {
    flex: 1 1 200px;
    max-width: 320px;
  }
  @media (max-width: 640px) {
    .graph-page {
      padding: 12px 16px 16px;
    }
    .gp-head {
      padding: 24px 0 20px;
    }
  }
</style>