---
import Base from '../layouts/Base.astro';
import { url } from '../lib/nav';
---

<Base title="Page not found" description="This page does not exist.">
  <main class="lost">
    <p class="code">404</p>
    <h1>Nothing on this shelf</h1>
    <p class="tag">The link you followed does not lead to a note. It may have been renamed, or it may not be written yet.</p>
    <a class="btn primary" href={url()}>Back to the graph</a>
  </main>
</Base>

<style>
  .lost {
    max-width: 720px;
    margin: 0 auto;
    padding: 96px 24px 120px;
  }
  .code {
    margin: 0 0 12px;
    font: 500 0.875rem var(--font-mono);
    color: var(--accent);
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 3rem);
    letter-spacing: -0.04em;
    line-height: 1.05;
  }
  .tag {
    margin: 16px 0 28px;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .btn {
    display: inline-block;
    padding: 9px 16px;
    text-decoration: none;
  }
</style>
